# React Native / Expo + Metro resolve modules from a flat tree. Use the hoisted
# node-linker so native modules and Metro work reliably under pnpm.
node-linker=hoisted

# RN libraries publish loose peer ranges; do not fail install on peer mismatch.
strict-peer-dependencies=false
auto-install-peers=true

# CI installs run against EAS Build's internal npm cache proxy, which returns transient 504 Gateway
# Timeouts under load. pnpm's default of 2 fetch retries gives up too early and fails the whole
# `install --frozen-lockfile`. Raise the retry count, backoff and per-request timeout so a flaky
# cache fetch recovers instead of breaking the build.
fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
